@model UnitFormViewModel

<form asp-action="@(Model.IsEdit ? "EditUnit" : "CreateUnit")" asp-route-id="@Model.Id" method="post" id="unitForm">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PropertyId" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="UnitNumber" class="form-label"></label>
        <input asp-for="UnitNumber" class="form-control" />
        <span asp-validation-for="UnitNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UnitTypeId" class="form-label"></label>
        <select asp-for="UnitTypeId" asp-items="Model.UnitTypeOptions" class="form-select">
            <option value="">Select a unit type</option>
        </select>
        <span asp-validation-for="UnitTypeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Bedrooms" class="form-label"></label>
        <input asp-for="Bedrooms" type="number" min="0" class="form-control" />
        <span asp-validation-for="Bedrooms" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MonthlyRent" class="form-label"></label>
        <input asp-for="MonthlyRent" type="number" min="0.01" step="0.01" class="form-control" />
        <span asp-validation-for="MonthlyRent" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save Changes" : "Create Unit")</button>
    </div>
</form>