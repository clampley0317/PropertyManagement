@model UnitsPageViewModel

@{
    ViewData["Title"] = "Manage Units";
}

<h1>Manage Units</h1>
<h5 class="text-muted">@Model.PropertyName</h5>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Properties</a>

    <button type="button" class="btn btn-primary"
            data-unit-modal-url="@Url.Action("CreateUnit", new { propertyId = Model.PropertyId })"
            data-unit-modal-title="Add Unit">
        Add Unit
    </button>
</div>

<div id="unitTableContainer" data-refresh-url="@Url.Action("UnitTable", new { propertyId = Model.PropertyId })">
    <vc:unit-table property-id="Model.PropertyId" />
</div>

<div class="modal fade" id="unitModal" tabindex="-1" aria-labelledby="unitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="unitModalLabel">Add Unit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="unitModalBody">Loading...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const unitModalElement = document.getElementById("unitModal");
        const unitModalBody = document.getElementById("unitModalBody");
        const unitModalTitle = document.getElementById("unitModalLabel");
        const unitModal = new bootstrap.Modal(unitModalElement);
        const unitTableContainer = document.getElementById("unitTableContainer");

        async function refreshUnitTable() {
            const response = await fetch(unitTableContainer.dataset.refreshUrl);
            if (response.ok) {
                unitTableContainer.innerHTML = await response.text();
            }
        }

        document.addEventListener("click", async event => {
            const trigger = event.target.closest("[data-unit-modal-url]");
            if (!trigger) return;

            unitModalTitle.textContent = trigger.dataset.unitModalTitle;
            unitModalBody.innerHTML = "Loading...";
            unitModal.show();

            const response = await fetch(trigger.dataset.unitModalUrl);
            unitModalBody.innerHTML = response.ok
                ? await response.text()
                : "<p class='text-danger'>Could not load the form.</p>";
        });

        unitModalElement.addEventListener("submit", async event => {
            if (event.target.id !== "unitForm") return;
            event.preventDefault();

            const form = event.target;
            const response = await fetch(form.action, { method: "POST", body: new FormData(form) });

            if (!response.ok) {
                unitModalBody.innerHTML = "<p class='text-danger'>The request failed.</p>";
                return;
            }

            if ((response.headers.get("content-type") ?? "").includes("application/json")) {
                const result = await response.json();
                if (result.success) {
                    unitModal.hide();
                    await refreshUnitTable();
                    return;
                }
            }

            // Validation failed: the server returned the same partial with errors.
            unitModalBody.innerHTML = await response.text();
        });

        document.addEventListener("submit", async event => {
            const form = event.target.closest(".delete-unit-form");
            if (!form) return;
            event.preventDefault();

            if (!confirm("Delete this unit?")) return;

            const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
            const result = await response.json().catch(() => null);

            if (response.ok && result?.success) {
                await refreshUnitTable();
                return;
            }

            alert(result?.message ?? "Could not delete this unit.");
        });
    </script>
}