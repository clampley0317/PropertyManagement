@model IEnumerable<PropertyManagement.Models.Unit>

@{
    ViewData["Title"] = "Manage Units";
    var propertyId = (int)ViewBag.PropertyId;
    var propertyName = (string)ViewBag.PropertyName;
}

<h1>Manage Units</h1>
<h5 class="text-muted">@propertyName</h5>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Properties
    </a>

    <button type="button" class="btn btn-primary" id="addUnitButton">
        Add Unit
    </button>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Unit Number</th>
            <th>Type</th>
            <th>Bedrooms</th>
            <th>Monthly Rent</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in Model)
        {
            <tr>
                <td>@unit.UnitNumber</td>
                <td>@unit.UnitType.Name</td>
                <td>@unit.Bedrooms</td>
                <td style="text-align:right;">@unit.MonthlyRent.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="unitModal" tabindex="-1" aria-labelledby="unitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="unitModalLabel">
                    Add Unit
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="unitModalBody">
                Loading...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const propertyId = @propertyId;
        const unitModalElement = document.getElementById("unitModal");
        const unitModalBody = document.getElementById("unitModalBody");
        const unitModal = new bootstrap.Modal(unitModalElement);

        document.getElementById("addUnitButton")
            .addEventListener("click", async () => {
                unitModalBody.innerHTML = "Loading...";
                unitModal.show();

                const response = await fetch(
                    `/Manager/CreateUnit?propertyId=${propertyId}`
                );

                if (!response.ok) {
                    unitModalBody.innerHTML =
                        "<p class='text-danger'>Could not load the form.</p>";
                    return;
                }

                unitModalBody.innerHTML = await response.text();
            });

        unitModalElement.addEventListener("submit", async event => {
            if (event.target.id !== "createUnitForm") {
                return;
            }

            event.preventDefault();

            const form = event.target;
            const response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form)
            });

            if (!response.ok) {
                unitModalBody.innerHTML =
                    "<p class='text-danger'>The request failed.</p>";
                return;
            }

            const contentType =
                response.headers.get("content-type") ?? "";

            if (contentType.includes("application/json")) {
                const result = await response.json();

                if (result.success) {
                    window.location.reload();
                    return;
                }
            }

            unitModalBody.innerHTML = await response.text();
        });
    </script>
}