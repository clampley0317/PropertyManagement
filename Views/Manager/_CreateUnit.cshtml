@model PropertyManagement.Models.Unit
@using Microsoft.AspNetCore.Mvc.Rendering

<form asp-controller="Manager" asp-action="CreateUnit" method="post" id="createUnitForm">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PropertyId" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="UnitNumber" class="form-label"></label>
        <input asp-for="UnitNumber" class="form-control" />
        <span asp-validation-for="UnitNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UnitTypeId" class="form-label">
            Unit Type
        </label>
        <select asp-for="UnitTypeId" class="form-select" asp-items="@(new SelectList(
                    (IEnumerable<PropertyManagement.Models.UnitType>)ViewBag.UnitTypes,
                    nameof(PropertyManagement.Models.UnitType.Id),
                    nameof(PropertyManagement.Models.UnitType.Name)))">
            <option value="">Select a unit type</option>
        </select>
        <span asp-validation-for="UnitTypeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Bedrooms" class="form-label"></label>
        <input asp-for="Bedrooms" type="number" min="0" class="form-control" />
        <span asp-validation-for="Bedrooms" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MonthlyRent" class="form-label">
            Monthly Rent
        </label>
        <input asp-for="MonthlyRent" type="number" min="0.01" step="0.01" class="form-control" />
        <span asp-validation-for="MonthlyRent" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            Create Unit
        </button>
    </div>
</form>