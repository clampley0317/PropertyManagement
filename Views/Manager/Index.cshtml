@{
    ViewData["Title"] = "Property Manager Dashboard";
}

<h1>Property Manager Dashboard</h1>

<p>Manage your properties and rental units.</p>

<button type="button" class="btn btn-primary mb-3" data-property-modal-url="@Url.Action("CreateProperty")"
        data-property-modal-title="Add Property">
    Add Property
</button>

<div id="propertyTableContainer" data-refresh-url="@Url.Action("PropertyTable")">
    <vc:property-table />
</div>

<div class="modal fade" id="propertyModal" tabindex="-1" aria-labelledby="propertyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="propertyModalLabel">Add Property</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="propertyModalBody">Loading...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const propertyModalElement = document.getElementById("propertyModal");
        const propertyModalBody = document.getElementById("propertyModalBody");
        const propertyModalTitle = document.getElementById("propertyModalLabel");
        const propertyModal = new bootstrap.Modal(propertyModalElement);
        const propertyTableContainer = document.getElementById("propertyTableContainer");

        async function refreshPropertyTable() {
            const response = await fetch(propertyTableContainer.dataset.refreshUrl);
            if (response.ok) {
                propertyTableContainer.innerHTML = await response.text();
            }
        }

        document.addEventListener("click", async event => {
            const trigger = event.target.closest("[data-property-modal-url]");
            if (!trigger) return;

            propertyModalTitle.textContent = trigger.dataset.propertyModalTitle;
            propertyModalBody.innerHTML = "Loading...";
            propertyModal.show();

            const response = await fetch(trigger.dataset.propertyModalUrl);
            propertyModalBody.innerHTML = response.ok
                ? await response.text()
                : "<p class='text-danger'>Could not load the form.</p>";
        });

        propertyModalElement.addEventListener("submit", async event => {
            if (event.target.id !== "propertyForm") return;
            event.preventDefault();

            const form = event.target;
            const response = await fetch(form.action, { method: "POST", body: new FormData(form) });

            if (!response.ok) {
                propertyModalBody.innerHTML = "<p class='text-danger'>The request failed.</p>";
                return;
            }

            if ((response.headers.get("content-type") ?? "").includes("application/json")) {
                const result = await response.json();
                if (result.success) {
                    propertyModal.hide();
                    await refreshPropertyTable();
                    return;
                }
            }

            propertyModalBody.innerHTML = await response.text();
        });

        document.addEventListener("submit", async event => {
            const form = event.target.closest(".delete-property-form");
            if (!form) return;
            event.preventDefault();

            if (!confirm("Delete this property?")) return;

            const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
            const result = await response.json().catch(() => null);

            if (response.ok && result?.success) {
                await refreshPropertyTable();
                return;
            }

            alert(result?.message ?? "Could not delete this property.");
        });
    </script>
}
