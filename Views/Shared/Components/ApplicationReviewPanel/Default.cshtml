@model ApplicationReviewPanelViewModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong>Status:</strong>
            <span class="badge text-bg-secondary fs-6">@Model.Status</span>
            @if (Model.LeaseStart is not null)
            {
                <span class="ms-2 text-muted">
                    Lease @Model.LeaseStart.Value.ToString("d") – @Model.LeaseEnd!.Value.ToString("d")
                </span>
            }
        </div>
        @if (Model.IsReviewable)
        {
            <button type="button" class="btn btn-primary btn-sm"
                    data-review-modal-url="@Url.Action("Review", "Applications", new { id = Model.ApplicationId })">
                Review
            </button>
        }
    </div>
    <div class="card-body">
        <h2 class="h6">Status History</h2>
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Change</th>
                    <th>By</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.History)
                {
                    <tr>
                        <td class="text-nowrap">@entry.ChangedAt.ToString("g")</td>
                        <td class="text-nowrap">
                            @(entry.FromStatus is null ? "Created" : $"{entry.FromStatus} → {entry.ToStatus}")
                        </td>
                        <td>@entry.ChangedBy</td>
                        <td>@entry.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
