@model IReadOnlyList<UnitRowViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted">This property has no units yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Unit Number</th>
                <th>Type</th>
                <th>Bedrooms</th>
                <th class="text-end">Monthly Rent</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.UnitNumber</td>
                    <td>
                        @unit.UnitTypeName
                        @if (!unit.UnitTypeIsActive)
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@unit.Bedrooms</td>
                    <td class="text-end">@unit.MonthlyRent.ToString("C")</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-unit-modal-url="@Url.Action("EditUnit", "Manager", new { id = unit.Id })"
                                data-unit-modal-title="Edit Unit @unit.UnitNumber">
                            Edit
                        </button>
                        <form asp-controller="Manager" asp-action="DeleteUnit" asp-route-id="@unit.Id" method="post"
                              class="delete-unit-form d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}