@model IReadOnlyList<PropertyRowViewModel>

<div class="mb-3">
    <strong>Total properties:</strong> @Model.Count
    <br />
    <strong>Total units:</strong> @Model.Sum(p => p.UnitCount)
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No properties yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Units</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var property in Model)
            {
                <tr>
                    <td>@property.Name</td>
                    <td>@property.Address</td>
                    <td>@property.City</td>
                    <td>@property.State</td>
                    <td>@property.UnitCount</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-property-modal-url="@Url.Action("EditProperty", "Manager", new { id = property.Id })"
                                data-property-modal-title="Edit @property.Name">
                            Edit
                        </button>
                        <a asp-controller="Manager" asp-action="Units" asp-route-propertyId="@property.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Manage Units
                        </a>
                        <form asp-controller="Manager" asp-action="DeleteProperty" asp-route-id="@property.Id"
                              method="post" class="delete-property-form d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
