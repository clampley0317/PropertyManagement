@model int

@{
    var (title, message) = Model switch
    {
        403 => ("Access denied", "You don't have permission to do that."),
        404 => ("Page not found", "The page you're looking for doesn't exist, or you don't have access to it."),
        409 => ("Request conflict", "That action can't be completed in the item's current state. Reload the page and try again."),
        _ => ("Something went wrong", "The request couldn't be completed.")
    };

    ViewData["Title"] = title;
}

<div class="py-5 text-center">
    <p class="display-1 text-muted">@Model</p>
    <h1 class="h3">@title</h1>
    <p class="text-muted mb-4">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to the home page</a>
</div>
