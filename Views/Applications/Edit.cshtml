@model ApplicationWizardViewModel

@{
    var isManager = User.IsInRole(AppRoles.PropertyManager);

    ViewData["Title"] = $"Application #{Model.Id}";

    var steps = new (ApplicationSection Section, string Label)[]
    {
        (ApplicationSection.ApplicantInfo, "Applicant Information"),
        (ApplicationSection.ResidenceHistory, "Residence History"),
        (ApplicationSection.Summary, "Summary")
    };

    var sectionPartial = Model.Section switch
    {
        ApplicationSection.ApplicantInfo => "_ApplicantInfoSection",
        ApplicationSection.ResidenceHistory => "_ResidenceHistorySection",
        _ => "_Summary"
    };
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">Rental Application</h1>
        <div class="text-muted">@Model.UnitDescription</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!isManager)
        {
            <span class="badge text-bg-secondary fs-6">@Model.Status</span>
        }

        @if (Model.CanWithdraw)
        {
            <form asp-action="Withdraw" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Withdraw this application? This cannot be undone.');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
            </form>
        }
    </div>
</div>

@if (isManager)
{
    <div id="reviewPanel" class="mb-4" data-refresh-url="@Url.Action("ReviewPanel", new { id = Model.Id })">
        <vc:application-review-panel application-id="Model.Id" />
    </div>

    <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewModalLabel">Review Application #@Model.Id</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="reviewModalBody">Loading...</div>
            </div>
        </div>
    </div>
}


<ul class="nav nav-pills mb-4">
    @for (var i = 0; i < steps.Length; i++)
    {
        <li class="nav-item">
            <a class="nav-link @(steps[i].Section == Model.Section ? "active" : "")" asp-action="Edit"
               asp-route-id="@Model.Id" asp-route-section="@steps[i].Section">
                @(i + 1). @steps[i].Label
            </a>
        </li>
    }
</ul>

@if (Model.IsEditable)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Section" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="@sectionPartial" model="Model" />

        <div class="d-flex flex-row-reverse justify-content-between mt-4">
            @if (Model.Section == ApplicationSection.Summary)
            {
                <button type="submit" name="command" value="submit" class="btn btn-success" disabled="@(!Model.CanSubmit)">
                    Submit Application
                </button>
            }
            else
            {
                <button type="submit" name="command" value="continue" class="btn btn-primary">
                    Save &amp; Continue
                </button>
            }

            @if (Model.Section != ApplicationSection.ApplicantInfo)
            {
                <button type="submit" name="command" value="back" class="btn btn-outline-secondary" formnovalidate>
                    Back
                </button>
            }
        </div>
    </form>
}
else
{
    <partial name="@sectionPartial" model="Model" />
}

@if (Model.IsEditable && Model.Section == ApplicationSection.ResidenceHistory)
{
    <div class="modal fade" id="residenceModal" tabindex="-1" aria-labelledby="residenceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="residenceModalLabel">Add Residence</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="residenceModalBody">Loading...</div>
            </div>
        </div>
    </div>
}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const residenceModalElement = document.getElementById("residenceModal");

        if (residenceModalElement) {
            const residenceModal = new bootstrap.Modal(residenceModalElement);
            const residenceModalBody = document.getElementById("residenceModalBody");
            const residenceModalTitle = document.getElementById("residenceModalLabel");

            // The wizard form's antiforgery token, sent as a header by the Remove button.
            const antiForgeryToken = () =>
                document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

            async function refreshResidences() {
                const section = document.getElementById("residenceHistorySection");
                const response = await fetch(section.dataset.refreshUrl);
                if (response.ok) {
                    section.outerHTML = await response.text();
                }
            }

            document.addEventListener("click", async event => {
                const trigger = event.target.closest("[data-residence-modal-url]");
                if (!trigger) return;

                residenceModalTitle.textContent = trigger.dataset.residenceModalTitle;
                residenceModalBody.innerHTML = "Loading...";
                residenceModal.show();

                const response = await fetch(trigger.dataset.residenceModalUrl);
                residenceModalBody.innerHTML = response.ok
                    ? await response.text()
                    : "<p class='text-danger'>Could not load the form.</p>";
            });

            residenceModalElement.addEventListener("submit", async event => {
                if (event.target.id !== "residenceForm") return;
                event.preventDefault();

                const form = event.target;
                const response = await fetch(form.action, { method: "POST", body: new FormData(form) });

                if (!response.ok) {
                    residenceModalBody.innerHTML = "<p class='text-danger'>The request failed. Reload the page and try again.</p>";
                    return;
                }

                if ((response.headers.get("content-type") ?? "").includes("application/json")) {
                    const result = await response.json();
                    if (result.success) {
                        residenceModal.hide();
                        await refreshResidences();
                        return;
                    }
                }

                // Validation failed: the server returned the same partial with errors.
                residenceModalBody.innerHTML = await response.text();
            });

            document.addEventListener("click", async event => {
                const button = event.target.closest("[data-residence-delete-url]");
                if (!button) return;

                if (!confirm("Remove this residence?")) return;

                const response = await fetch(button.dataset.residenceDeleteUrl, {
                    method: "POST",
                    headers: { "RequestVerificationToken": antiForgeryToken() }
                });

                if (response.ok) {
                    await refreshResidences();
                    return;
                }

                alert("Could not remove this residence. Reload the page and try again.");
            });
        }

        const reviewModalElement = document.getElementById("reviewModal");

        if (reviewModalElement) {
            const reviewModal = new bootstrap.Modal(reviewModalElement);
            const reviewModalBody = document.getElementById("reviewModalBody");
            const reviewPanel = document.getElementById("reviewPanel");

            async function refreshReviewPanel() {
                const response = await fetch(reviewPanel.dataset.refreshUrl);
                if (response.ok) {
                    reviewPanel.innerHTML = await response.text();
                }
            }

            document.addEventListener("click", async event => {
                const trigger = event.target.closest("[data-review-modal-url]");
                if (!trigger) return;

                reviewModalBody.innerHTML = "Loading...";
                reviewModal.show();

                const response = await fetch(trigger.dataset.reviewModalUrl);
                reviewModalBody.innerHTML = response.ok
                    ? await response.text()
                    : "<p class='text-danger'>This application can no longer be reviewed.</p>";
            });

            reviewModalElement.addEventListener("submit", async event => {
                if (event.target.id !== "reviewForm") return;
                event.preventDefault();

                const form = event.target;
                const response = await fetch(form.action, { method: "POST", body: new FormData(form) });

                if (!response.ok) {
                    reviewModalBody.innerHTML = "<p class='text-danger'>The request failed. Reload the page and try again.</p>";
                    return;
                }

                if ((response.headers.get("content-type") ?? "").includes("application/json")) {
                    const result = await response.json();
                    if (result.success) {
                        reviewModal.hide();
                        await refreshReviewPanel();
                        return;
                    }
                }

                reviewModalBody.innerHTML = await response.text();
            });
        }

    </script>
}
