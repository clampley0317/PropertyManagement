@model ReviewApplicationViewModel

<form asp-action="Review" asp-route-id="@Model.ApplicationId" method="post" id="reviewForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <fieldset class="mb-3">
        <legend class="form-label fs-6">Outcome</legend>
        @foreach (var outcome in Enum.GetValues<ReviewOutcome>())
        {
            var id = $"outcome-{outcome}";
            <div class="form-check form-check-inline">
                <input asp-for="Outcome" type="radio" value="@outcome" id="@id" class="form-check-input" />
                <label for="@id" class="form-check-label">@outcome</label>
            </div>
        }
        <div><span asp-validation-for="Outcome" class="text-danger"></span></div>
    </fieldset>

    <div class="mb-3">
        <label asp-for="Comment" class="form-label">Comment <span class="text-muted small">(required to return or
            deny)</span></label>
            <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Complete Review</button>
        </div>
    </form>
