@model ApplicationListViewModel

@{
    ViewData["Title"] = Model.IsManager ? "Applications" : "My Applications";
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()" class="form-select">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <label asp-for="PropertyId" class="form-label">Property</label>
        <select asp-for="PropertyId" asp-items="Model.Properties" class="form-select">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.Applications.Count == 0)
{
    <p class="text-muted">
        No applications match these filters.
        @if (!Model.IsManager)
        {
            <a asp-controller="Units" asp-action="Index">Browse available units</a>
        }
    </p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>#</th>
                @if (Model.IsManager)
                {
                    <th>Applicant</th>
                }
                <th>Property</th>
                <th>Unit</th>
                <th>Status</th>
                <th>Submitted</th>
                <th>Last Updated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var application in Model.Applications)
            {
                <tr>
                    <td>@application.Id</td>
                    @if (Model.IsManager)
                    {
                        <td>@application.ApplicantName</td>
                    }
                    <td>@application.PropertyName</td>
                    <td>@application.UnitNumber</td>
                    <td>
                        <partial name="_StatusBadge" model="application.Status" />
                    </td>
                    <td>@(application.SubmittedAt?.ToString("d") ?? "—")</td>
                    <td>@application.UpdatedAt.ToString("d")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-outline-primary">
                            @(Model.IsManager && application.Status == ApplicationStatus.Submitted ? "Review" : "Open")
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
